<?xml version="1.0" encoding="utf-8"?>
<!--
  mono: a black-and-white, text-only home screen.

  Deliberately requests NO permissions, has NO services, NO manifest
  broadcast receivers and NO internet access. It cannot change other apps.

  HomeActivity ships disabled, so installing mono changes nothing.
  The "mono" app in your app list (SwitchActivity) turns it on and off.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nilupul.mono"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Lets mono see which apps can be opened (package visibility, not a permission). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
    </queries>

    <application
        android:label="mono"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Mono"
        android:allowBackup="false"
        android:supportsRtl="false">

        <!-- The home screen. Off until you turn it on from the mono app. -->
        <activity
            android:name=".HomeActivity"
            android:enabled="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The on/off switch, shown as "mono" in your app list. -->
        <activity
            android:name=".SwitchActivity"
            android:exported="true"
            android:taskAffinity="com.nilupul.mono.switch"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
